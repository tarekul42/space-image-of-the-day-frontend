{
  "name": "space-image-of-the-day-frontend",
  "version": "2.0.0",
  "description": "Frontend for Space Image of the Day Chrome Extension",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "BROWSER=chrome vite build",
    "build:chrome": "BROWSER=chrome vite build",
    "build:firefox": "BROWSER=firefox vite build",
    "build:all": "bun run build:chrome && bun run build:firefox",
    "check:version": "bun scripts/check-version.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "d3-selection": "^3.0.1",
    "d3-zoom": "^3.0.1",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.15.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "typescript-native": "npm:typescript@^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
